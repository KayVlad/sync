{
  "manifest_version": 3,
  "name": "sync.",
  "description": "Your temporary LAN shelf. Sync text, links, images and direct video files.",
  "version": "1.2.0",
  "omnibox": {"keyword": "sync"},
  "minimum_chrome_version": "123",
  "permissions": ["storage", "contextMenus", "downloads", "clipboardWrite", "activeTab", "scripting", "offscreen", "alarms"],
  "commands": {"quick-send": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Sync selected text or the current URL"}},
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "sync.", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}
}
